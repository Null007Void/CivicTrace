# Documentation only. Neither launch.py nor python -m civictrace loads .env files.
# Recommended: python launch.py (offline), or python launch.py --live (private hidden prompt).
# Never put a real credential in this example or in version control.
# Advanced direct/container configuration; replace storage paths with your own writable directories.
CIVICTRACE_LIVE_ENABLED=0
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
CIVICTRACE_DEPLOYMENT_ID=civictrace-local-v1
CIVICTRACE_SPEND_BACKEND=sqlite
CIVICTRACE_MAX_LIVE_ATTEMPTS=2
CIVICTRACE_MAX_LIVE_USD=0.90
CIVICTRACE_EST_USD_PER_PROVIDER_REQUEST=0.15
# CIVICTRACE_CASE_STORE=<absolute writable directory>/cases.json
# CIVICTRACE_SPEND_STORE_PATH=<absolute existing writable directory>/spend
# CIVICTRACE_SPEND_STORE_EXPECT_ROOT=<same spend directory>
# Inject NEBIUS_API_KEY privately only when explicitly enabling live mode.
# Attempts count claim investigations, each with at most THREE provider requests.
